@* FR-1.5: change password. Other browser sessions are signed out; this one stays signed in. *@
@inject AccountService Accounts

<h2>change password</h2>

<EditForm Model="Input" FormName="change-password" OnSubmit="ChangeAsync" method="post">
    <ErrorMessage Error="error" />
    @if (changed)
    {
        <p role="status">password changed. other sessions were signed out.</p>
    }
    <p>
        <label for="current-password">current password</label><br />
        <InputText id="current-password" type="password" @bind-Value="Input!.Current" autocomplete="current-password" required />
    </p>
    <p>
        <label for="new-password">new password</label><br />
        <InputText id="new-password" type="password" @bind-Value="Input!.New" autocomplete="new-password" required
                   minlength="@AccountService.PasswordMinLength" maxlength="@AccountService.PasswordMaxLength" />
    </p>
    <p>
        <label for="confirm-password">confirm new password</label><br />
        <InputText id="confirm-password" type="password" @bind-Value="Input!.Confirm" autocomplete="new-password" required />
    </p>
    <p><button type="submit">change password</button></p>
</EditForm>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "change-password")] private ChangePasswordModel? Input { get; set; }
    private ServiceError? error;
    private bool changed;

    protected override void OnInitialized() => Input ??= new();

    private async Task ChangeAsync()
    {
        var current = Input!.Current;
        var next = Input.New;
        var confirm = Input.Confirm;
        Input = new(); // never echo passwords back into the page

        if (next != confirm)
        {
            error = new ServiceError(ErrorKind.Invalid, "password_mismatch", "The new passwords don't match.");
            return;
        }
        var result = await Accounts.ChangePasswordAsync(HttpContext.User.GetUserId()!.Value, current, next);
        if (!result.Ok)
        {
            error = result.Error;
            return;
        }
        // The security stamp changed, so re-issue this browser's cookie (as UsersController does).
        await WebSignIn.SignInAsync(HttpContext, result.Value!);
        changed = true;
    }

    private class ChangePasswordModel
    {
        public string? Current { get; set; }
        public string? New { get; set; }
        public string? Confirm { get; set; }
    }
}
