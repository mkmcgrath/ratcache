@page "/p/{Id}"
@inject PasteService Pastes
@inject NavigationManager Nav

@* FR-2.3: show a paste. Missing, expired and someone else's private paste all get the
   same NotFound page (NFR-4.2).
   TODO FR-4.2 / FR-4.4: syntax highlighting and line numbers.
   TODO FR-2.9: copy link / copy content buttons. *@
@if (paste is not null)
{
    <PageTitle>@Heading</PageTitle>

    <h1>@Heading</h1>

    <p>
        @PasteChoices.LanguageLabel(paste.Language)
        · @PasteChoices.Lower(paste.Visibility)
        · created <Timestamp Value="paste.CreatedAt" />
        @if (paste.UpdatedAt is { } updated)
        {
            <text> · edited </text><Timestamp Value="updated" />
        }
        · @if (paste.ExpiresAt is { } expires) { <text>expires </text><Timestamp Value="expires" /> } else { <text>never expires</text> }
    </p>

    <p>
        <a href="raw/@paste.Id">raw</a>
        @if (IsOwner)
        {
            <text> · </text><a href="p/@paste.Id/edit">edit</a>
        }
    </p>

    @if (IsOwner || HttpContext.User.IsAdmin())
    {
        <form method="post" @formname="delete-paste" @onsubmit="DeleteAsync">
            <AntiforgeryToken />
            <ErrorMessage Error="error" />
            <button type="submit">delete paste</button>
        </form>
    }

    <pre><code>@paste.Content</code></pre>
}

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [Parameter] public string Id { get; set; } = "";

    private RatCache.Web.Services.PasteView? paste;
    private ServiceError? error;

    private int? UserId => HttpContext.User.GetUserId();
    private bool IsOwner => paste?.OwnerId is { } owner && owner == UserId;
    private string Heading => paste?.Title ?? $"paste {Id}";

    protected override async Task OnInitializedAsync()
    {
        var result = await Pastes.GetAsync(Id, UserId);
        if (!result.Ok)
        {
            Nav.NotFound();
            return;
        }
        paste = result.Value;
    }

    // FR-2.6 (owner) / FR-7.1 (admin).
    private async Task DeleteAsync()
    {
        if (UserId is not { } userId) return;
        var result = await Pastes.DeleteAsync(Id, userId, HttpContext.User.IsAdmin());
        if (!result.Ok)
        {
            error = result.Error;
            return;
        }
        Nav.NavigateTo(IsOwner ? "my" : "/");
    }
}
