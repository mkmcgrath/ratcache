@page "/p/{Id}"
@inject PasteService Pastes
@inject NavigationManager Nav

@* FR-2.3: show a paste. Missing, expired and someone else's private paste all get the
   same NotFound page (NFR-4.2).
   FR-4.2: wwwroot/js/paste.js highlights <code data-lang> in the browser with the vendored
   highlight.js (wwwroot/lib/highlight). FR-4.4: line numbers are rendered here, so they show
   without JS. FR-2.9: the copy/share buttons are also paste.js; they stay hidden without JS.
   Paste content is only ever output as text (@paste.Content), never as MarkupString (NFR-3.3). *@
@if (paste is not null)
{
    <PageTitle>@Heading</PageTitle>

    <h1>@Heading</h1>

    <p>
        @PasteChoices.LanguageLabel(paste.Language)
        · @PasteChoices.Lower(paste.Visibility)
        · created <Timestamp Value="paste.CreatedAt" />
        @if (paste.UpdatedAt is { } updated)
        {
            <text> · edited </text><Timestamp Value="updated" />
        }
        · @if (paste.ExpiresAt is { } expires) { <text>expires </text><Timestamp Value="expires" /> } else { <text>never expires</text> }
    </p>

    <p>
        <a href="raw/@paste.Id">raw</a>
        @if (IsOwner)
        {
            <text> · </text><a href="p/@paste.Id/edit">edit</a>
        }
    </p>

    @if (IsOwner || HttpContext.User.IsAdmin())
    {
        <form method="post" @formname="delete-paste" @onsubmit="DeleteAsync">
            <AntiforgeryToken />
            <ErrorMessage Error="error" />
            <button type="submit">delete paste</button>
        </form>
    }

    <p class="share-bar" data-share-bar data-id="@paste.Id" hidden>
        <button type="button" data-copy="link">copy link</button>
        <button type="button" data-copy="content">copy text</button>
        <button type="button" data-copy="raw">copy raw link</button>
        <button type="button" data-share hidden>share</button>
        <span data-copy-status role="status" aria-live="polite"></span>
    </p>

    <p data-highlight-note hidden>too long to highlight; shown as plain text.</p>

    <div class="paste-body">
        <pre class="line-numbers" aria-hidden="true">@lineNumbers</pre>
        <pre class="paste-code"><code data-lang="@paste.Language">@paste.Content</code></pre>
    </div>
}

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [Parameter] public string Id { get; set; } = "";

    private RatCache.Web.Services.PasteView? paste;
    private ServiceError? error;

    private int? UserId => HttpContext.User.GetUserId();
    private bool IsOwner => paste?.OwnerId is { } owner && owner == UserId;
    private string Heading => paste?.Title ?? $"paste {Id}";

    protected override async Task OnInitializedAsync()
    {
        var result = await Pastes.GetAsync(Id, UserId);
        if (!result.Ok)
        {
            Nav.NotFound();
            return;
        }
        paste = result.Value;
        lineNumbers = LineNumbers(paste!.Content);
    }

    private string lineNumbers = "";

    // "1\n2\n3": one number per line the browser will show. Browsers treat \r\n and a lone \r
    // in HTML text as one line break, and a final newline doesn't start a visible line.
    public static string LineNumbers(string content)
    {
        var text = content.Replace("\r\n", "\n").Replace('\r', '\n');
        var count = text.Count(c => c == '\n') + 1;
        if (count > 1 && text.EndsWith('\n')) count--;
        return string.Join('\n', Enumerable.Range(1, count));
    }

    // FR-2.6 (owner) / FR-7.1 (admin).
    private async Task DeleteAsync()
    {
        if (UserId is not { } userId) return;
        var result = await Pastes.DeleteAsync(Id, userId, HttpContext.User.IsAdmin());
        if (!result.Ok)
        {
            error = result.Error;
            return;
        }
        Nav.NavigateTo(IsOwner ? "my" : "/");
    }
}
