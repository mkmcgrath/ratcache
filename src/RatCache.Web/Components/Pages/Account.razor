@page "/account"

<PageTitle>account</PageTitle>

<h1>account</h1>

@* Signed out: sign in / register (FR-1.1, 1.3). Signed in: settings (FR-1.4, 1.5, 1.6, 1.8).
   Pages that require sign-in ([Authorize]) redirect here with ?ReturnUrl=. *@
@if (HttpContext.User.GetUserId() is null)
{
    <SignInForm ReturnUrl="@ReturnUrl" />
    <RegisterForm ReturnUrl="@ReturnUrl" />
}
else
{
    <p>signed in as <strong>@HttpContext.User.Identity!.Name</strong></p>
    <SignOutForm />
    <ChangePasswordForm />
    <ApiTokens />
    <DeleteAccountForm />
}

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
}
