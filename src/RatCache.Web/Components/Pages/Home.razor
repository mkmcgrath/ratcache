@page "/"
@using RatCache.Web.Models

<PageTitle>ratcache</PageTitle>

<h1>new paste</h1>

@* TODO FR-5.1 / FR-2.1: wire this form up to create a paste.
   Not hooked up yet, so the submit button is disabled. *@
<form>
    <p>
        <label for="title">title</label><br />
        <input id="title" name="title" maxlength="200" />
    </p>
    <p>
        <textarea id="content" name="content" rows="20" placeholder="paste here"></textarea>
    </p>
    <p>
        <label for="language">language</label>
        <select id="language" name="language">
            @foreach (var (id, label) in Languages.All)
            {
                <option value="@id">@label</option>
            }
        </select>

        <label for="visibility">visibility</label>
        <select id="visibility" name="visibility">
            <option value="public">public</option>
            <option value="unlisted">unlisted</option>
            <option value="private">private (signed in)</option>
        </select>

        <label for="expire">expires</label>
        <select id="expire" name="expire">
            <option value="never">never</option>
            <option value="10m">10 minutes</option>
            <option value="1h">1 hour</option>
            <option value="1d">1 day</option>
            <option value="1w">1 week</option>
            <option value="1mo">1 month</option>
        </select>
    </p>
    <p>
        <button type="submit" disabled>create paste</button>
    </p>
</form>
