@page "/"
@inject PasteService Pastes
@inject NavigationManager Nav

<PageTitle>ratcache</PageTitle>

<h1>new paste</h1>

@* FR-5.1 / FR-2.1: create a paste, then go to its page. Anonymous or signed in. *@
<EditForm Model="Input" FormName="new-paste" OnSubmit="CreateAsync" method="post">
    <ErrorMessage Error="error" />
    <p>
        <label for="title">title</label><br />
        <InputText id="title" @bind-Value="Input!.Title" maxlength="@PasteService.TitleMaxLength" />
    </p>
    <p>
        <InputTextArea id="content" @bind-Value="Input!.Content" rows="20" placeholder="paste here" required />
    </p>
    <p>
        <label for="language">language</label>
        <InputSelect id="language" @bind-Value="Input!.Language">
            @foreach (var (id, label) in Languages.All)
            {
                <option value="@id">@label</option>
            }
        </InputSelect>

        <label for="visibility">visibility</label>
        <InputSelect id="visibility" @bind-Value="Input!.Visibility">
            @foreach (var (value, label) in PasteChoices.VisibilityOptions)
            {
                @if (value == "private" && !SignedIn)
                {
                    <option value="@value" disabled>@label (sign in first)</option>
                }
                else
                {
                    <option value="@value">@label</option>
                }
            }
        </InputSelect>

        <label for="expire">expires</label>
        <InputSelect id="expire" @bind-Value="Input!.Expire">
            @foreach (var (value, label) in PasteChoices.ExpireOptions)
            {
                <option value="@value">@label</option>
            }
        </InputSelect>
    </p>
    <p>
        <button type="submit">create paste</button>
        <small>max @(SignedIn ? "5 MB" : "1 MB; sign in for 5 MB")</small>
    </p>
</EditForm>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "new-paste")] private PasteForm? Input { get; set; }
    private ServiceError? error;

    private bool SignedIn => HttpContext.User.GetUserId() is not null;

    protected override void OnInitialized() => Input ??= new();

    private async Task CreateAsync()
    {
        var input = new NewPaste(PasteChoices.NormalizeNewlines(Input!.Content), Input.Title,
            Input.Language, Input.Visibility, Input.Expire);
        var result = await Pastes.CreateAsync(input, HttpContext.User.GetUserId());
        if (!result.Ok)
        {
            error = result.Error;
            return;
        }
        Nav.NavigateTo($"p/{result.Value!.Id}");
    }
}
