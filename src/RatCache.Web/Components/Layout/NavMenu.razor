<nav>
    <NavLink href="" Match="NavLinkMatch.All"><strong>ratcache</strong></NavLink>
    <NavLink href="recent">recent</NavLink>
    <NavLink href="my">my pastes</NavLink>
    <NavLink href="account">@(HttpContext?.User.Identity?.IsAuthenticated == true ? HttpContext.User.Identity.Name : "sign in")</NavLink>
